    {
      "id": "6d088354-ddf6-4d56-aeaa-477991db4c8c",
      "name": "Documents internes fictifs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const docs = [\n  { source: 'Politique de remboursement.pdf', texte: \"Politique de remboursement de l'Atelier Nova. Un client peut demander le remboursement d'une prestation non commencée dans les 30 jours suivant la commande. Une prestation commencée n'est pas remboursée : elle donne lieu à un avoir valable 12 mois, calculé au prorata des livrables non remis. Les frais de déplacement engagés ne sont jamais remboursés. Toute demande passe par le responsable de compte, qui répond sous 5 jours ouvrés.\" },\n  { source: \"Procédure d'accueil client.pdf\", texte: \"Procédure d'accueil d'un nouveau client. Le rendez-vous de lancement a lieu dans les 5 jours ouvrés suivant la signature. Le client reçoit ses accès à l'espace projet le jour du lancement. Un responsable de compte unique est nommé pour toute la durée du contrat. Le premier point d'étape a lieu au bout de 30 jours, avec un rapport écrit envoyé la veille.\" },\n  { source: 'Grille tarifaire 2026.pdf', texte: \"Grille tarifaire 2026. Forfait Essentiel : 490 euros HT par mois, 2 livrables par mois. Forfait Pro : 890 euros HT par mois, 5 livrables par mois et un point hebdomadaire. Forfait Sur mesure : sur devis. Les forfaits Essentiel et Pro sont engagés pour 6 mois minimum ; une résiliation avant 6 mois entraîne la facturation des mois restants. Un paiement annuel donne droit à 10 pour cent de remise.\" }\n];\nreturn docs.map(d => ({ json: d }));"
      }
    },
