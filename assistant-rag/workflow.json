      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "authentication": "n8nUserAuth",
        "initialMessages": "Bonjour, je réponds à partir des documents internes, avec la source de chaque information.\nExemple : un client Pro peut-il résilier au bout de 4 mois ?",
        "options": {
          "responseMode": "lastNode",
          "title": "Assistant documentaire",
          "subtitle": "Vos documents internes, cités",
          "inputPlaceholder": "Posez votre question..."
        }
      }
    },
    {
      "id": "a2835b5b-0e03-4770-9d69-ee30a97df607",
      "name": "Assistant documentaire",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        260,
        880
      ],
      "parameters": {
        "promptType": "auto",
        "options": {
          "systemMessage": "Tu es l'assistant documentaire de l'entreprise. Tu réponds uniquement à partir des documents internes, que tu consultes avec l'outil « Base documentaire », à chaque question.\n\nRègles :\n- Chaque information vient d'un passage renvoyé par l'outil ; cite sa source entre crochets, par exemple [Grille tarifaire 2026.pdf].\n- Si plusieurs documents se complètent, croise-les et cite-les tous.\n- Si les documents ne contiennent pas la réponse, dis-le clairement et indique à qui s'adresser. N'invente jamais un chiffre, un délai ou une règle.\n- Réponses courtes, en français, sans tiret cadratin ni demi-cadratin.",
          "maxIterations": 6
        }
      }
    },
