    {
      "id": "d9d56dd9-d806-4650-88ad-abfc7f38616a",
      "name": "Lire le site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        112
      ],
      "parameters": {
        "url": "={{ $json.site || \"https://example.com\" }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text"
            }
          },
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
