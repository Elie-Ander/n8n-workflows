      "id": "4d42dc1e-1c3c-4d7b-bb60-a5e7767cdf96",
      "name": "Démarrer une séquence",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        112
      ],
      "parameters": {
        "formTitle": "Nouvelle séquence de prospection",
        "formDescription": "Le prospect reçoit un premier message personnalisé, puis deux relances si besoin. La séquence s'arrête dès sa réponse.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Prénom",
              "fieldName": "prenom",
              "requiredField": true
            },
            {
              "fieldLabel": "Nom",
              "fieldName": "nom"
            },
            {
              "fieldLabel": "E-mail",
              "fieldName": "email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Entreprise",
              "fieldName": "entreprise",
              "requiredField": true
            },
            {
              "fieldLabel": "Site web",
              "fieldName": "site",
              "placeholder": "https://exemple.fr"
            },
            {
              "fieldLabel": "Contexte",
              "fieldName": "contexte",
              "fieldType": "textarea",
              "placeholder": "Signal observé, besoin repéré, recommandation…"
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Lancer la séquence",
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Séquence lancée : le premier message part dans une minute."
            }
          }
        }
      }
    },
