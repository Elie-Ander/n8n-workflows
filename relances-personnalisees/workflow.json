    {
      "id": "bc0882a5-82c7-4475-803b-9fdeebb7e82c",
      "name": "Préparer le contexte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const p = $('Configuration').item.json;\nconst html = p.site ? String($json.data || '') : '';\nconst texte = html.replace(/<script[\\s\\S]*?<\\/script>/gi, ' ').replace(/<style[\\s\\S]*?<\\/style>/gi, ' ').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 3000);\nreturn { json: { ...p, consigne: 'Prospect : ' + p.prenom + ' ' + (p.nom || '') + ', ' + p.entreprise + '\\nContexte : ' + (p.contexte || 'aucun') + '\\nNotre offre : ' + p.offre + '\\nSignature : ' + p.expediteur + '\\n\\nExtrait du site :\\n' + (texte || 'site non lu') } };"
      }
    },
    {
      "id": "19df4e14-7313-475f-8f76-42d3a412f64b",
      "name": "Écrire la séquence",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        896,
        112
      ],
      "parameters": {
        "text": "={{ $json.consigne }}",
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"objet\":{\"type\":\"string\",\"description\":\"Objet court, sans majuscules partout, sans point d'exclamation\"},\"message_1\":{\"type\":\"string\",\"description\":\"Premier contact\"},\"message_2\":{\"type\":\"string\",\"description\":\"Première relance, qui apporte un élément nouveau\"},\"message_3\":{\"type\":\"string\",\"description\":\"Dernier message, bref, qui laisse la porte ouverte\"}},\"required\":[\"objet\",\"message_1\",\"message_2\",\"message_3\"]}",
        "options": {
          "systemPromptTemplate": "Tu écris une séquence de prospection B2B en français, au vouvoiement. Règles : 90 mots au plus par message ; une accroche précise tirée du contexte ou du site, jamais générique ; une seule question par message ; aucun lien, aucune pièce jointe, aucun superlatif ; pas de tiret cadratin. Chaque message commence par « Bonjour » suivi du prénom et se termine par la signature fournie. N'invente aucun fait sur l'entreprise."
        }
      }
    },
