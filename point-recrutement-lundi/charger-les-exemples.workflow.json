        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Un refus porte un motif cohérent avec la dernière étape atteinte (règle fixe, sans hasard)\nconst REGLE = {\n  1: ['Profil hors critères', 'Profil hors critères', 'Candidat retiré'],\n  2: ['Profil hors critères', 'Valeurs', 'Prétentions hors grille', 'Candidat retiré'],\n  3: ['Business case insuffisant', 'Business case insuffisant', 'Candidat retiré'],\n  4: ['Valeurs', 'Candidat retiré', 'Prétentions hors grille', 'Poste pourvu'],\n};\nconst COLS = ['recue_le','premier_echange_le','business_case_le','entretien_metier_le','entretien_inverse_le','entretien_final_le','offre_le','embauche_le'];\nreturn $input.all().map((item) => {\n  const l = { ...item.json };\n  if (l.statut === 'Refusé') {\n    const n = COLS.filter((c) => l[c]).length;\n    const liste = REGLE[Math.min(n, 4)];\n    l.motif_refus = liste[parseInt(l.candidat.slice(2), 10) % liste.length];\n  }\n  return { json: l };\n});"
