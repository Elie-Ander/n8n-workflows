    {
      "id": "5dd83da3-d467-4af0-8134-c5d24945beb4",
      "name": "Préparer le texte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        210
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const texte = String($json.text || '').replace(/[ \\t]+/g, ' ').replace(/\\n{3,}/g, '\\n\\n').trim();\nconst b = $input.item.binary && $input.item.binary.data;\nconst fichier = (b && b.fileName) || 'document.pdf';\nreturn { json: { texte: texte.slice(0, 20000), fichier, lisible: texte.replace(/\\s/g, '').length >= 40 } };"
      }
    },
    {
      "id": "72a299ab-404f-43c2-aa35-ba86f7df56c5",
      "name": "Texte lisible ?",
