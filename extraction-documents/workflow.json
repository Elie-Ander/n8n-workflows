    {
      "id": "b2c186ea-7b99-4046-a8c2-46a265468806",
      "name": "Extraire les données",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1440,
        210
      ],
      "parameters": {
        "text": "={{ $json.texte }}",
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"type_document\":{\"type\":\"string\",\"enum\":[\"facture\",\"devis\",\"avoir\",\"autre\"]},\"fournisseur\":{\"type\":\"string\",\"description\":\"Raison sociale de l'émetteur du document\"},\"siret\":{\"type\":\"string\",\"description\":\"SIRET de l'émetteur, 14 chiffres sans espace, vide si absent\"},\"numero\":{\"type\":\"string\",\"description\":\"Numéro de la facture ou du devis\"},\"date_emission\":{\"type\":\"string\",\"description\":\"Date au format AAAA-MM-JJ\"},\"date_echeance\":{\"type\":\"string\",\"description\":\"Date d'échéance ou de validité au format AAAA-MM-JJ, vide si absente\"},\"devise\":{\"type\":\"string\",\"description\":\"Code ISO de la devise, EUR par défaut\"},\"montant_ht\":{\"type\":\"number\"},\"tva\":{\"type\":\"number\",\"description\":\"Montant total de TVA\"},\"montant_ttc\":{\"type\":\"number\"},\"iban\":{\"type\":\"string\",\"description\":\"IBAN indiqué pour le paiement, vide si absent\"},\"lignes\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"designation\":{\"type\":\"string\"},\"quantite\":{\"type\":\"number\"},\"prix_unitaire\":{\"type\":\"number\"},\"total_ht\":{\"type\":\"number\"}}}}},\"required\":[\"type_document\",\"fournisseur\",\"numero\",\"montant_ttc\"]}",
        "options": {
          "systemPromptTemplate": "Tu extrais les données d'une facture ou d'un devis rédigé en français. Recopie les valeurs telles qu'elles figurent dans le document et n'invente rien : un champ absent reste vide, un montant absent vaut 0. Les montants sont des nombres avec un point décimal, sans symbole. Les dates sont au format AAAA-MM-JJ."
        }
      }
    },
    {
      "id": "774b0598-897f-444b-941c-c81563d1078e",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        1520,
        440
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5",
          "cachedResultName": "Claude Sonnet 5"
        },
        "options": {}
      }
    },
    {
      "id": "0bfdd590-12b9-47ec-95b9-f1c3c7355a53",
      "name": "Contrôler le document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        210
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const cfg = $('Configuration').item.json;\nconst d = $json.output || {};\nconst n = v => { const x = typeof v === 'number' ? v : parseFloat(String(v ?? '').replace(/\\s/g, '').replace(',', '.')); return Number.isFinite(x) ? Math.round(x * 100) / 100 : 0; };\nconst ht = n(d.montant_ht), tva = n(d.tva), ttc = n(d.montant_ttc);\nconst lignes = Array.isArray(d.lignes) ? d.lignes : [];\nconst tol = Number(cfg.ecart_tolere) || 0.05;\nconst devise = d.devise || 'EUR';\nconst anomalies = [];\nif (!d.numero) anomalies.push('Numéro de document absent.');\nif (!d.fournisseur) anomalies.push('Fournisseur non identifié.');\nif (ttc <= 0) anomalies.push('Montant TTC absent.');\nif (ht > 0 && ttc > 0 && Math.abs(ht + tva - ttc) > tol) anomalies.push('HT + TVA = ' + (ht + tva).toFixed(2) + ', mais le TTC indiqué est ' + ttc.toFixed(2) + '.');\nconst sommeLignes = Math.round(lignes.reduce((s, l) => s + n(l.total_ht), 0) * 100) / 100;\nif (lignes.length && ht > 0 && Math.abs(sommeLignes - ht) > tol) anomalies.push('La somme des lignes (' + sommeLignes.toFixed(2) + ') ne correspond pas au HT (' + ht.toFixed(2) + ').');\nif (ht > 0 && tva > 0) { const taux = tva / ht * 100; if (![20, 10, 5.5, 2.1].some(t => Math.abs(taux - t) < 0.3)) anomalies.push('Taux de TVA inhabituel : ' + taux.toFixed(1) + ' %.'); }\nconst siret = String(d.siret || '').replace(/\\s/g, '');\nconst luhn = s => { let sum = 0; for (let i = 0; i < s.length; i++) { let k = +s[s.length - 1 - i]; if (i % 2) { k *= 2; if (k > 9) k -= 9; } sum += k; } return sum % 10 === 0; };\nif (siret && !(/^\\d{14}$/.test(siret) && luhn(siret))) anomalies.push('SIRET invalide : ' + siret + '.');\nconst iban = String(d.iban || '').replace(/\\s/g, '').toUpperCase();\nconst ibanValide = s => { if (!/^[A-Z]{2}\\d{2}[A-Z0-9]{10,30}$/.test(s)) return false; const r = (s.slice(4) + s.slice(0, 4)).replace(/[A-Z]/g, c => String(c.charCodeAt(0) - 55)); let m = 0; for (const ch of r) m = (m * 10 + Number(ch)) % 97; return m === 1; };\nif (iban && !ibanValide(iban)) anomalies.push('IBAN invalide : à vérifier avant tout paiement.');\nif (d.type_document === 'facture' && d.date_echeance && d.date_echeance < $now.toISODate()) anomalies.push('Échéance dépassée depuis le ' + d.date_echeance + '.');\nconst seuil = Number(cfg.seuil_validation) || 0;\nif (seuil > 0 && ttc >= seuil) anomalies.push('Montant au-dessus du seuil de validation (' + seuil + ' ' + devise + ').');\nreturn { json: { fichier: cfg.fichier, type_document: d.type_document || 'autre', fournisseur: d.fournisseur || '', siret, numero: String(d.numero || ''), date_emission: d.date_emission || '', date_echeance: d.date_echeance || '', devise, montant_ht: ht, tva, montant_ttc: ttc, iban, lignes: JSON.stringify(lignes), anomalies } };"
      }
    },
    {
      "id": "53723e95-069d-4b3c-a4f9-d9961533fd5b",
      "name": "Chercher un doublon",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        2040,
        210
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Documents extraits"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "numero",
              "condition": "eq",
              "keyValue": "={{ $json.numero }}"
            },
            {
              "keyName": "fournisseur",
              "condition": "eq",
              "keyValue": "={{ $json.fournisseur }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "alwaysOutputData": true
    },
    {
      "id": "0c4481b2-5904-4ba9-8258-e7967f68b4ea",
      "name": "Consolider",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        210
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const doc = $('Contrôler le document').first().json;\nconst anomalies = [...doc.anomalies];\nconst doublon = !!doc.numero && $input.all().some(i => i.json && i.json.id);\nif (doublon) anomalies.unshift('Déjà reçu : même numéro et même fournisseur.');\nconst statut = doublon ? 'doublon' : (anomalies.length ? 'à vérifier' : 'conforme');\nconst libelle = { facture: 'Facture', devis: 'Devis', avoir: 'Avoir' }[doc.type_document] || 'Document';\nconst titre = libelle + ' ' + (doc.numero || 'sans numéro') + ' de ' + (doc.fournisseur || 'fournisseur inconnu');\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst message = ['<b>' + esc(statut === 'doublon' ? 'Doublon détecté' : 'Document à vérifier') + '</b>', esc(titre), 'TTC : ' + doc.montant_ttc.toFixed(2) + ' ' + doc.devise, ''].concat(anomalies.map(a => '• ' + esc(a))).join('\\n');\nreturn [{ json: { ...doc, anomalies: anomalies.join(' '), statut, titre, message, recu_le: $now.toISO() } }];"
      }
    },
