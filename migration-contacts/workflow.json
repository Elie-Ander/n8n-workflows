      "id": "1574a67c-6079-42be-aca7-e0f646c9c456",
      "name": "Ecrire dans la cible",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1200,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $('Preparer et controler').all().map(i => i.json);\nconst cfg = $('Configuration').first().json;\nconst total = items.length;\nconst valides = items.filter(i => i.statut === 'valide').length;\nconst rejetes = total - valides;\nconst doublons = items.filter(i => i.doublon === true).length;\nconst details = items\n  .filter(i => i.statut === 'rejete')\n  .slice(0, 15)\n  .map(i => (i.source_id || i.email || 'sans identifiant') + ' : ' + i.raisons)\n  .join('\\n');\n\nreturn [{\n  json: {\n    run_id: items.length ? items[0].run_id : 'mig-' + $now.toFormat('yyyyLLdd-HHmmss'),\n    run_at: $now.toISO(),\n    mode: String(cfg.mode || 'test').toLowerCase(),\n    total: total,\n    valides: valides,\n    rejetes: rejetes,\n    doublons: doublons,\n    champs_non_mappes: items.length ? items[0].champs_non_mappes : '',\n    details: details\n  }\n}];"
      },
