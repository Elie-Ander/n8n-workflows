    {
      "parameters": {
        "jsCode": "const cfg = $('Configuration').first().json;\nconst mapping = JSON.parse(cfg.mapping || '{}');\nconst obligatoires = String(cfg.champs_obligatoires || 'email').split(',').map(s => s.trim()).filter(Boolean);\nconst paysDefaut = String(cfg.pays_defaut || 'FR').toUpperCase();\nconst mode = String(cfg.mode || 'test').toLowerCase();\nconst indicatifs = { FR: '33', BE: '32', CH: '41', LU: '352', ES: '34', IT: '39', DE: '49' };\nconst runId = 'mig-' + $now.toFormat('yyyyLLdd-HHmmss');\nconst systeme = ['id', 'createdAt', 'updatedAt'];\n\nfunction emailValide(v) { return /^[^\\s@]+@[^\\s@]+\\.[A-Za-z]{2,}$/.test(v); }\n\nfunction consentement(v) {\n  const s = String(v == null ? '' : v).trim().toLowerCase();\n  if (['oui', 'yes', 'true', '1', 'y', 'o'].includes(s)) return { valeur: true, connu: true };\n  if (['non', 'no', 'false', '0', 'n'].includes(s)) return { valeur: false, connu: true };\n  return { valeur: false, connu: false };\n}\n\nfunction telephone(v, pays) {\n  let s = String(v == null ? '' : v).replace(/[^\\d+]/g, '');\n  if (!s) return '';\n  if (s.startsWith('00')) s = '+' + s.slice(2);\n  if (s.startsWith('0')) s = '+' + (indicatifs[pays] || indicatifs[paysDefaut] || '33') + s.slice(1);\n  if (!s.startsWith('+')) s = '+' + s;\n  return s;\n}\n\nfunction dateIso(v) {\n  const s = String(v == null ? '' : v).trim();\n  if (!s) return { valeur: null, ok: false };\n  const d = new Date(s);\n  if (isNaN(d.getTime())) return { valeur: null, ok: false };\n  return { valeur: d.toISOString(), ok: true };\n}\n\nconst vus = new Map();\nconst nonMappes = new Set();\nconst sortie = [];\n\nfor (const item of $input.all()) {\n  const src = item.json;\n  const cible = {};\n  for (const [de, vers] of Object.entries(mapping)) cible[vers] = src[de];\n  for (const cle of Object.keys(src)) {\n    if (!systeme.includes(cle) && !(cle in mapping)) nonMappes.add(cle);\n  }\n\n  const raisons = [];\n  const email = String(cible.email == null ? '' : cible.email).trim().toLowerCase();\n  cible.email = email;\n  if (!email) raisons.push('email absent');\n  else if (!emailValide(email)) raisons.push('email invalide');\n\n  const pays = String(cible.country == null ? '' : cible.country).trim().toUpperCase() || paysDefaut;\n  cible.country = pays;\n  cible.phone = telephone(cible.phone, pays);\n\n  const optinEmail = consentement(cible.email_subscribed);\n  const optinSms = consentement(cible.sms_subscribed);\n  cible.email_subscribed = optinEmail.valeur;\n  cible.sms_subscribed = optinSms.valeur;\n  if (!optinEmail.connu) raisons.push('consentement e-mail non renseigne, passe a non');\n\n  const d = dateIso(cible.created_at);\n  cible.created_at = d.valeur;\n  if (!d.ok) raisons.push('date d inscription illisible');\n\n  for (const champ of obligatoires) {\n    const vers = mapping[champ] || champ;\n    const val = cible[vers];\n    if (val === undefined || val === null || String(val).trim() === '') raisons.push('champ obligatoire vide : ' + champ);\n  }\n\n  let doublon = false;\n  if (email) {\n    if (vus.has(email)) { doublon = true; raisons.push('doublon de ' + vus.get(email)); }\n    else vus.set(email, src.external_id || email);\n  }\n\n  const bloquant = raisons.some(r => /email absent|email invalide|champ obligatoire|doublon/.test(r));\n\n  sortie.push({\n    json: Object.assign({}, cible, {\n      run_id: runId,\n      mode: mode,\n      statut: bloquant ? 'rejete' : 'valide',\n      doublon: doublon,\n      raisons: raisons.join(' ; '),\n      source_id: src.external_id || '',\n      champs_non_mappes: ''\n    })\n  });\n}\n\nconst liste = Array.from(nonMappes).sort().join(', ');\nfor (const s of sortie) s.json.champs_non_mappes = liste;\nreturn sortie;"
      },
