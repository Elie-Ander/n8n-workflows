      "id": "dac037fa-bc95-496a-ba07-15affc5d2553",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        150
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "c-relance",
              "name": "relance_automatique",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "c-fenetre",
              "name": "fenetre_anti_doublon_min",
