    {
      "id": "21a6a3a6-1f14-4274-bebe-6825ba5366bb",
      "name": "Préparer le bilan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        560
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.id);\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nif (!rows.length) return [{ json: { message: '<b>Bilan des 24 dernières heures</b>\\nAucun incident. Tous les workflows ont tourné sans erreur.' } }];\nconst parWf = {}; const parType = {};\nfor (const r of rows) { parWf[r.workflow || 'inconnu'] = (parWf[r.workflow || 'inconnu'] || 0) + 1; parType[r.type || 'autre'] = (parType[r.type || 'autre'] || 0) + 1; }\nconst top = Object.entries(parWf).sort((a, b) => b[1] - a[1]).slice(0, 8).map(([w, n]) => '• ' + esc(w) + ' : ' + n);\nconst types = Object.entries(parType).map(([t, n]) => t + ' ' + n).join(', ');\nconst relances = rows.filter(r => r.relance).length;\nreturn [{ json: { message: ['<b>Bilan des 24 dernières heures</b>', rows.length + ' incident' + (rows.length > 1 ? 's' : '') + ' (' + types + '), ' + relances + ' relance' + (relances > 1 ? 's' : '') + ' automatique' + (relances > 1 ? 's' : '') + '.', ''].concat(top).join('\\n') } }];"
      }
    },
