    {
      "id": "49607233-5856-45b7-ae58-c748c400440e",
      "name": "Analyser l'erreur",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        150
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const e = $('Quand un workflow échoue').first().json;\nconst cfg = $('Configuration').first().json;\nconst ex = e.execution || {}; const wf = e.workflow || {}; const err = ex.error || {};\nconst msg = String(err.message || err.description || 'Erreur sans message').slice(0, 500);\nconst noeud = (err.node && err.node.name) || ex.lastNodeExecuted || 'inconnu';\nconst code = String(err.httpCode || (err.context && err.context.httpCode) || '');\nlet type = 'autre';\nif (/timeout|ETIMEDOUT|ECONNRESET|ECONNREFUSED|socket hang up|EAI_AGAIN|rate limit|too many requests|overloaded|temporarily/i.test(msg) || /^(429|5\\d\\d)$/.test(code)) type = 'passager';\nelse if (/^(401|403)$/.test(code) || /unauthori[sz]ed|forbidden|credential|invalid api key|authentication/i.test(msg)) type = 'connexion';\nelse if (/^(400|404|422)$/.test(code) || /validation|required|invalid|not found|cannot read prop|undefined/i.test(msg)) type = 'données';\nconst sd = $getWorkflowStaticData('global'); const maintenant = Date.now();\nconst cle = (wf.id || '') + '|' + noeud + '|' + type;\nsd.vus = Object.fromEntries(Object.entries(sd.vus || {}).filter(([, t]) => maintenant - t < 86400000));\nconst fenetre = (Number(cfg.fenetre_anti_doublon_min) || 30) * 60000;\nconst doublon = !!sd.vus[cle] && maintenant - sd.vus[cle] < fenetre;\nif (!doublon) sd.vus[cle] = maintenant;\nconst relancer = type === 'passager' && !!ex.id && !ex.retryOf && cfg.relance_automatique === true;\nlet origine = ''; try { origine = new URL(ex.url).origin; } catch (x) { origine = ''; }\nconst conseils = { passager: 'Incident passager : délai dépassé, limite de débit ou service indisponible.', connexion: 'Connexion refusée : vérifier ou renouveler les identifiants du service.', 'données': 'Donnée manquante ou invalide : vérifier ce que le nœud a reçu.', autre: \"Erreur inattendue : ouvrir l'exécution pour la lire en détail.\" };\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst lignes = ['<b>Échec : ' + esc(wf.name || 'workflow inconnu') + '</b>', 'Nœud : ' + esc(noeud), 'Type : ' + type + (relancer ? ', relance automatique demandée' : ''), '', esc(msg), '', conseils[type]];\nif (ex.url) lignes.push('<a href=\"' + ex.url + '\">Ouvrir l\\'exécution</a>');\nreturn [{ json: { survenu_le: $now.toISO(), workflow: wf.name || '', noeud, type, message: msg, execution_id: String(ex.id || ''), lien: ex.url || '', relancer, doublon, origine, alerte: lignes.join('\\n') } }];"
      }
    },
