    {
      "id": "bbb4a673-7a25-4abe-b6ca-82e73e45b926",
      "name": "Une ligne par compte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const cfg = $('Configuration').first().json;\nreturn String(cfg.comptes || '').split('\\n').map(l => l.split('|').map(s => s.trim())).filter(([n]) => n).map(([entreprise, domaine]) => ({ json: { entreprise, domaine: domaine || '' } }));"
      }
    },
    {
      "id": "d2478099-a766-47c5-823a-3b6e2f51e8d4",
      "name": "Chercher les signaux (Perplexity)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        112
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/v1/agent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "perplexityApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ preset: \"fast\", tools: [ { type: \"web_search\", filters: { search_recency_filter: \"month\" } } ], instructions: \"Tu es analyste commercial. Réponds en français, uniquement avec des faits datés et sourcés, sans spéculation.\", input: \"Quels signaux d'achat récents, sur les 30 derniers jours, pour l'entreprise \" + $json.entreprise + \" (\" + $json.domaine + \") : levée de fonds, recrutements commerciaux ou marketing, nouveau dirigeant, ouverture de bureau ou de pays, lancement de produit, rachat ? Donne chaque fait avec sa date et sa source. S'il n'y a rien, dis-le simplement.\" }) }}",
        "options": {
          "timeout": 60000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          }
        }
      },
      "retryOnFail": true
    },
    {
      "id": "18830ef7-6321-4057-bcdc-5d675c347343",
      "name": "Préparer l'analyse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const compte = $('Une ligne par compte').item.json;\nconst cfg = $('Configuration').first().json;\n// API Agent de Perplexity : une liste typée, le texte dans \"message\", les sources dans \"search_results\"\nconst sorties = Array.isArray($json.output) ? $json.output : [];\nconst texte = ($json.output_text || sorties.filter(o => o.type === 'message').flatMap(o => o.content || []).map(c => c.text || '').join('\\n')).trim();\nconst urls = sorties.filter(o => o.type === 'search_results').flatMap(o => o.results || []).concat(Array.isArray($json.search_results) ? $json.search_results : []).map(r => r.url).filter(Boolean);\nconst sources = [...new Set(urls)].slice(0, 8);\nreturn { json: { ...compte, faits: texte || 'Aucun fait trouvé.', sources: sources.join('\\n'), consigne: 'Entreprise : ' + compte.entreprise + ' (' + compte.domaine + ')\\nNotre offre : ' + cfg.offre + '\\n\\nFaits trouvés :\\n' + (texte || 'Aucun fait trouvé.') + '\\n\\nSources :\\n' + sources.join('\\n') } };"
      }
    },
    {
      "id": "333cd919-fb2c-4459-b454-d5f7c67c9d1a",
      "name": "Qualifier les signaux",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        1120,
        112
      ],
      "parameters": {
        "text": "={{ $json.consigne }}",
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"signaux\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"type\":{\"type\":\"string\",\"enum\":[\"levee_de_fonds\",\"recrutement\",\"nouveau_dirigeant\",\"expansion\",\"lancement_produit\",\"rachat\",\"autre\"]},\"resume\":{\"type\":\"string\"},\"date\":{\"type\":\"string\",\"description\":\"AAAA-MM-JJ si connue\"},\"source\":{\"type\":\"string\"}}}},\"score\":{\"type\":\"number\",\"description\":\"De 0 à 100 : à quel point un signal récent rend notre offre pertinente maintenant\"},\"raison\":{\"type\":\"string\",\"description\":\"Pourquoi ce score, en une phrase\"},\"angle_approche\":{\"type\":\"string\",\"description\":\"Première phrase d'un message de prise de contact qui s'appuie sur le signal\"},\"interlocuteur_cible\":{\"type\":\"string\",\"description\":\"Fonction à contacter en priorité\"}},\"required\":[\"signaux\",\"score\",\"raison\"]}",
        "options": {
          "systemPromptTemplate": "Tu qualifies des signaux d'achat B2B. N'utilise que les faits fournis, n'en invente aucun. Un score élevé exige un signal récent et daté qui rend l'offre pertinente maintenant ; sans signal, le score reste sous 20. Réponds en français, sans tiret cadratin."
        }
      }
    },
    {
      "id": "ac56b0ae-b626-438b-9d41-d69064670078",
      "name": "Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        1200,
        336
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5",
          "cachedResultName": "Claude Sonnet 5"
        },
        "options": {}
      }
    },
    {
      "id": "708b5cb0-7156-4503-8595-6d496ef01403",
      "name": "Consolider",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const c = $('Préparer l\\'analyse').item.json; const o = $json.output || {};\nconst signaux = Array.isArray(o.signaux) ? o.signaux : [];\nreturn { json: { detecte_le: $now.toISO(), entreprise: c.entreprise, domaine: c.domaine, score: Math.max(0, Math.min(100, Number(o.score) || 0)), signaux: signaux.map(s => (s.date ? s.date + ' : ' : '') + s.resume).join(' | '), types: [...new Set(signaux.map(s => s.type))].join(', '), raison: o.raison || '', angle_approche: o.angle_approche || '', interlocuteur_cible: o.interlocuteur_cible || '', sources: c.sources } };"
      }
    },
