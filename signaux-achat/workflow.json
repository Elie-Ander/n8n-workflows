    {
      "id": "67feb0a4-e19c-42d6-95ba-c6b58630ff2f",
      "name": "Créer la tâche HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2144,
        112
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/tasks",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { hs_timestamp: $now.toISO(), hs_task_subject: \"Signal d'achat : \" + $('Consolider').item.json.entreprise + \" (\" + $('Consolider').item.json.score + \"/100)\", hs_task_body: $('Consolider').item.json.raison + \"\\n\\nSignaux : \" + $('Consolider').item.json.signaux + \"\\n\\nAngle : \" + $('Consolider').item.json.angle_approche + \"\\nÀ contacter : \" + $('Consolider').item.json.interlocuteur_cible, hs_task_priority: \"HIGH\", hs_task_status: \"NOT_STARTED\", hs_task_type: \"TODO\" } }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "9eac7eae-a844-458b-9f2d-9df4a005993f",
      "name": "Résumé de la semaine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2368,
        112
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst chauds = $('Compte chaud ?').all().map(i => i.json).sort((a, b) => b.score - a.score);\nconst lignes = ['<b>Signaux d\\'achat de la semaine</b>', chauds.length + ' compte' + (chauds.length > 1 ? 's' : '') + ' à contacter, tâches créées dans HubSpot.', ''];\nfor (const c of chauds) lignes.push('<b>' + esc(c.entreprise) + '</b> : ' + c.score + '/100', esc(c.raison), 'Angle : ' + esc(c.angle_approche), '');\nreturn [{ json: { message: lignes.join('\\n') } }];"
      }
    },
