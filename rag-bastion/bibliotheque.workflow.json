        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Lire la demande du portail : dresser la liste de la bibliothèque, ou retirer un document. Toute autre demande est refusée.\nconst e0 = $input.first().json || {};\nconst e = e0.body && typeof e0.body === 'object' && !Array.isArray(e0.body) ? e0.body : e0;\nconst action = String(e.action || 'lister'), doc_id = String(e.doc_id || '');\nconst valide = action === 'lister' || (action === 'retirer' && /^doc-[a-z0-9-]{4,40}$/.test(doc_id));\nreturn [{ json: { action: valide ? action : 'inconnue', doc_id: doc_id } }];"
      }
