    {
      "id": "5a61b003-0000-4000-8000-000000000009",
      "name": "Dresser la carte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -224
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Dresser la carte : chaque passage reçoit une position en deux dimensions, calculée à partir de son vecteur.\n// Deux passages proches sur la carte parlent du même sujet. Le calcul est une analyse en composantes principales, sans aucun service extérieur.\nconst docs = $('Lire le registre').all(0).map(i => i.json).filter(d => d && d.doc_id);\nconst lignes = $input.all().map(i => i.json).filter(l => l && l.doc_id && l.vecteur);\nconst V = lignes.map(l => { try { return JSON.parse(l.vecteur); } catch (err) { return []; } });\nconst n = V.length, dim = n ? V[0].length : 0;\nlet coords = V.map(() => [0, 0]);\nif (n > 1 && dim) {\n  const moy = new Array(dim).fill(0); V.forEach(v => { for (let i = 0; i < dim; i++) moy[i] += v[i] / n; });\n  const X = V.map(v => v.map((x, i) => x - moy[i]));\n  // Matrice des ressemblances entre passages (n × n) : bien plus petite que la matrice des 512 dimensions.\n  const G = X.map(a => X.map(b => { let s = 0; for (let i = 0; i < dim; i++) s += a[i] * b[i]; return s; }));\n  const axe = M => {                                // premier axe d'une matrice, par itérations ; départ fixe, pour une carte stable d'un appel à l'autre\n    let u = M.map((_, i) => 1 + ((i * 37) % 11) / 10), l = 0;\n    for (let k = 0; k < 120; k++) { const w = M.map(r => r.reduce((s, x, j) => s + x * u[j], 0)); l = Math.sqrt(w.reduce((s, x) => s + x * x, 0)) || 1; u = w.map(x => x / l); }\n    const fort = u.reduce((a, x) => Math.abs(x) > Math.abs(a) ? x : a, 0); if (fort < 0) u = u.map(x => -x);\n    return { u: u, l: l };\n  };\n  const a1 = axe(G), G2 = G.map((r, i) => r.map((x, j) => x - a1.l * a1.u[i] * a1.u[j])), a2 = axe(G2);\n  coords = V.map((_, i) => [a1.u[i] * Math.sqrt(a1.l), n > 2 ? a2.u[i] * Math.sqrt(a2.l) : 0]);\n}\n// Mise à l'échelle dans la carte, avec une marge : de 8 à 92 %.\nconst placer = k => { const xs = coords.map(c => c[k]), min = Math.min.apply(null, xs), max = Math.max.apply(null, xs), e = max - min; return coords.map(c => e > 1e-9 ? Math.round((8 + 84 * (c[k] - min) / e) * 10) / 10 : 50); };\nconst xs = n ? placer(0) : [], ys = n ? placer(1) : [];\nreturn [{ json: {\n  documents: docs.map(d => ({ doc_id: d.doc_id, titre: d.titre, version: d.version, origine: d.origine, source: d.source, nb_passages: d.nb_passages, en_service_le: d.en_service_le, nb_ecartes: d.nb_ecartes || 0, alertes: d.alertes || '[]' })),\n  passages: lignes.map((l, i) => ({ doc_id: l.doc_id, ordre: l.ordre, repere: l.repere, page: l.page, contenu: l.contenu, x: xs[i], y: ys[i] })) } }];"
      }
    },
