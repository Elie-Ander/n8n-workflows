      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Confirmer le retrait : le document est sorti du service, ses passages et leurs vecteurs sont effacés, la ligne du registre reste pour la trace.\nconst d = $('Chercher le document à retirer').first().json;\nreturn [{ json: { statut: 'retire', doc_id: d.doc_id, titre: d.titre, version: d.version, nb_passages: Number(d.nb_passages) || 0,\n  etapes: [{ nom: 'Retiré', detail: 'document hors service' }, { nom: 'Effacé', detail: (Number(d.nb_passages) || 0) + ' passages et leurs vecteurs' }, { nom: 'Noté', detail: 'retrait inscrit au registre' }] } }];"
      }
    },
    {
      "id": "5a61b003-0000-4000-8000-000000000016",
      "name": "Refuser la demande",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
