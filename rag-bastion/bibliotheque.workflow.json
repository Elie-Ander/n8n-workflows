      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Refuser clairement : demande inconnue, ou document qui n'est pas en service.\nconst d = $('Lire la demande').first().json;\nreturn [{ json: { statut: 'erreur', message: d.action === 'retirer' ? 'Ce document n\\'est pas en service : il a peut-être déjà été retiré.' : 'Demande inconnue : il faut « lister » ou « retirer ».' } }];"
      }
    },
    {
      "id": "5a61b003-0000-4000-8000-000000000017",
      "name": "Répondre au portail",
